{
  "name": "roulette-tg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm run format:check && npm test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "telegram:setup": "node --env-file-if-exists=.dev.vars scripts/telegram-setup.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:runtime": "node scripts/test-runtime.mjs"
  },
  "dependencies": {
    "grammy": "1.46.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.9",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "22.20.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.154.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.1-beta"
  }
}
