{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roulette-tg",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roulette-tg",
      "database_id": "3796777a-5435-4020-90a6-fdfae9035ee4",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "MatchmakerDO" },
      { "name": "SESSIONS", "class_name": "ChatSessionDO" },
      { "name": "TELEGRAM", "class_name": "TelegramDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MatchmakerDO", "ChatSessionDO", "TelegramDO"] },
  ],
  "triggers": { "crons": ["17 * * * *"] },
  "vars": {
    "BOT_USERNAME": "chatourlettebot",
    "GEOCODER_URL": "https://nominatim.openstreetmap.org",
    "GEOCODER_USER_AGENT": "roulette-tg/0.1 (https://t.me/nnajduu)",
    "SUPPORT_CONTACT": "Support: @nnajduu",
  },
}
